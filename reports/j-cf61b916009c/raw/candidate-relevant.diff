+    def _split_at_think_start(self, text: str) -> Tuple[str, str]:
+        """Remove the first opening marker and split off preceding content.
+
+        If reasoning was already opened by the chat template, text before an
+        echoed marker remains reasoning. Otherwise, the marker opens the block
+        and preceding text is normal content.
+        """
+        think_start_text = self.think_start_token + self.think_start_self_label
+        start_idx = text.find(think_start_text)
+        if start_idx <= 0:
+            return text, ""
+
+        preceding = text[:start_idx]
+        rest = text[start_idx + len(think_start_text) :]
+        if self._in_reasoning:
+            return preceding + rest, ""
+        return rest, preceding
+
