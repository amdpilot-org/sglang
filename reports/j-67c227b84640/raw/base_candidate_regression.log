        k_cache = torch.zeros((1, 1, 1, k_dim), device="cuda", dtype=torch.bfloat16)
        g_cache = torch.zeros((1, 1, 1, k_dim), device="cuda", dtype=torch.float32)
        indices = torch.zeros(1, device="cuda", dtype=torch.int32)
