+                    }
+                ],
+                "temperature": 0,
+                "max_tokens": 1,
+                "routed_dp_rank": 0,
+            },
+            timeout=120,
+        )
+
+        self.assertEqual(response.status_code, 200, response.text)
+        response_json = response.json()
+        self.assertEqual(len(response_json["choices"]), 1)
+
