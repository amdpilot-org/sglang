+class TestCascadeFlashInferIntegration(unittest.TestCase):
+    def test_real_wrappers_and_merge_match_monolithic_attention(self):
+        """Exercise the exact wrappers and merge kernel used by the backend.
+
+        This is intentionally separate from the portable split-softmax identity test:
+        it validates FlashInfer's page-table interpretation, forward_return_lse output,
+        and merge_state kernel whenever the test runs in the supported CUDA environment.
+        """
+        from flashinfer import BatchPrefillWithPagedKVCacheWrapper
+
+        torch.manual_seed(23)
+        device = "cuda"
+        batch, num_heads, head_dim = 4, 4, 64
+        shared_len, unique_len = 17, 5
+        workspace = torch.empty(32 * 1024 * 1024, dtype=torch.uint8, device=device)
+
+        q = torch.randn(
+            batch, num_heads, head_dim, dtype=torch.float16, device=device
+        )
+        shared_kv = torch.randn(
+            shared_len, 2, 1, num_heads, head_dim,
+            dtype=torch.float16,
+            device=device,
+        )
+        unique_kv = torch.randn(
+            batch, unique_len, 2, 1, num_heads, head_dim,
+            dtype=torch.float16,
+            device=device,
+        )
+        kv_cache = torch.cat((shared_kv, unique_kv.flatten(0, 1)), dim=0)
+
+        def run_wrapper(qo_indptr, kv_indptr, indices):
+            wrapper = BatchPrefillWithPagedKVCacheWrapper(workspace, "NHD")
+            wrapper.begin_forward(
+                qo_indptr,
+                kv_indptr,
+                indices,
+                torch.ones(len(kv_indptr) - 1, dtype=torch.int32, device=device),
+                num_heads,
+                num_heads,
+                head_dim,
+                1,
+                q_data_type=q.dtype,
+                kv_data_type=kv_cache.dtype,
+            )
+            return wrapper.forward_return_lse(q, kv_cache, causal=False)
+
+        shared_o, shared_lse = run_wrapper(
+            torch.tensor([0, batch], dtype=torch.int32, device=device),
+            torch.tensor([0, shared_len], dtype=torch.int32, device=device),
+            torch.arange(shared_len, dtype=torch.int32, device=device),
+        )
+        unique_indices = torch.arange(
+            shared_len, shared_len + batch * unique_len,
+            dtype=torch.int32,
+            device=device,
+        )
+        unique_o, unique_lse = run_wrapper(
+            torch.arange(batch + 1, dtype=torch.int32, device=device),
+            torch.arange(
+                0,
+                (batch + 1) * unique_len,
+                unique_len,
+                dtype=torch.int32,
+                device=device,
+            ),
+            unique_indices,
+        )
+        cascade_o, _ = backend._safe_merge_state(
+            shared_o, shared_lse, unique_o, unique_lse
+        )
+
+        reference = []
+        scale = 1 / math.sqrt(head_dim)
+        for request_idx in range(batch):
+            pages = torch.cat((shared_kv, unique_kv[request_idx]), dim=0)
+            keys = pages[:, 0, 0].float()
+            values = pages[:, 1, 0].float()
+            scores = torch.einsum("hd,thd->ht", q[request_idx].float(), keys) * scale
+            reference.append(torch.einsum("ht,thd->hd", scores.softmax(-1), values))
+
+        torch.testing.assert_close(
+            cascade_o.float(), torch.stack(reference), rtol=2e-2, atol=2e-2
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
