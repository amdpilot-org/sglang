+
+        class _GpuPkgFinder(importlib.abc.MetaPathFinder):
+            def __init__(self, pkg_name):
+                self.pkg_name = pkg_name
+
+            def find_spec(self, fullname, path, target=None):
+                if fullname == self.pkg_name or fullname.startswith(
+                    f"{self.pkg_name}."
